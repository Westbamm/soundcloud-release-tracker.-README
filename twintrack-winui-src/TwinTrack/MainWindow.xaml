<Window
    x:Class="TwinTrack.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TwinTrack"
    xmlns:vm="using:TwinTrack.ViewModels"
    Title="TWINTRACK">
    <Grid Background="#061A2D" RequestedTheme="Dark">
        <Grid.ColumnDefinitions><ColumnDefinition Width="254"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#071D31" BorderBrush="#143754" BorderThickness="0,0,1,0">
            <Grid Padding="18,22,16,18">
                <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="92"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Top">
                    <FontIcon Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="42" Foreground="#2A9DFF"/>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="TWINTRACK" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="AUDIO DUPLICATE FINDER" FontSize="10" Foreground="#5DA8DF"/></StackPanel>
                </StackPanel>
                <Grid Grid.Row="1"><TextBlock Text="ПАПКИ" FontSize="17" FontWeight="SemiBold" Foreground="#91B8D6" VerticalAlignment="Center"/><Button x:Name="AddFolderButton" Click="AddFolder_Click" HorizontalAlignment="Right" Width="32" Height="32" Padding="0" Background="#0B3150" BorderBrush="#21649A"><FontIcon Glyph="&#xE710;" FontSize="15"/></Button></Grid>
                <ListView x:Name="FoldersList" Grid.Row="2" SelectionChanged="FoldersList_SelectionChanged" Background="Transparent" BorderThickness="0" SelectionMode="Single" IsItemClickEnabled="False">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,5,0,5"/><Setter Property="MinHeight" Value="58"/><Setter Property="CornerRadius" Value="6"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate><DataTemplate x:DataType="vm:FolderVm"><Grid Padding="10,6"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8B7;" FontSize="19" Foreground="#75BFFF" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Path}" FontSize="9" Foreground="#6F9CBD" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind FileCount}" FontSize="10" Foreground="#8CC7F3" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="3" Tag="{x:Bind}" Click="RemoveFolder_Click" Width="26" Height="26" Padding="0" Background="#082641" BorderBrush="#245777"><FontIcon Glyph="&#xE738;" FontSize="12"/></Button></Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Spacing="5"><Rectangle Height="1" Fill="#173B56" Margin="0,0,0,5"/><Button Click="Trash_Click" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"><Grid Width="200"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="#90B4D0"/><TextBlock Grid.Column="1" Text="Корзина" VerticalAlignment="Center"/><TextBlock x:Name="TrashCount" Grid.Column="2" Text="0" HorizontalAlignment="Right" Foreground="#7CA7C7"/></Grid></Button><Button Click="Exit_Click" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8BB;" FontSize="15" Foreground="#90B4D0"/><TextBlock Text="Выход"/></StackPanel></Button></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Padding="24,26,20,12"><Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="82"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="Поиск дублей музыки" FontSize="31" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="SummaryText" Text="Добавьте папку с музыкой" Foreground="#7FB2D8" FontSize="12" Margin="2,2,0,0"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Top"><Button x:Name="ScanButton" Click="Scan_Click" Width="164" Height="46" Background="#1480DA"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE768;" FontSize="14"/><TextBlock Text="Сканировать" FontWeight="SemiBold"/></StackPanel></Button><Button x:Name="PauseButton" Click="Pause_Click" Width="150" Height="46" IsEnabled="False" Background="#0B2945" BorderBrush="#174A70"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon x:Name="PauseGlyph" Glyph="&#xE769;" FontSize="14"/><TextBlock x:Name="PauseLabel" Text="Пауза" FontWeight="SemiBold"/></StackPanel></Button></StackPanel></Grid>
            <Border Grid.Row="1" Background="#0A2944" BorderBrush="#123B5D" BorderThickness="1" CornerRadius="5" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="180"/><ColumnDefinition Width="2.6*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Исполнитель" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="#76A9CD"/><TextBlock Grid.Column="2" Text="Название" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="#76A9CD"/><TextBlock Grid.Column="3" Text="Размер" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="#76A9CD"/><TextBlock Grid.Column="4" Text="Формат" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="#76A9CD"/><TextBlock Grid.Column="5" Text="Папка" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="#76A9CD"/><TextBlock Grid.Column="6" Text="Действия" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="#76A9CD" HorizontalAlignment="Center"/></Grid></Border>
            <ListView x:Name="TracksList" Grid.Row="2" Margin="0,10,0,10" Background="Transparent" BorderThickness="0" SelectionMode="None" IsTabStop="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,3,0,3"/><Setter Property="MinHeight" Value="54"/><Setter Property="CornerRadius" Value="6"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="vm:TrackRowVm"><Border Background="#0A2944" BorderBrush="#12466D" BorderThickness="1" CornerRadius="5" Height="54" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="180"/><ColumnDefinition Width="2.6*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><CheckBox VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{x:Bind Artist}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind FileName}" FontSize="9" Foreground="#6798BC" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="3" Text="{x:Bind SizeText}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{x:Bind Format}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{x:Bind Folder}" FontSize="10" Foreground="#77A5C6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Tag="{x:Bind}" Click="ShowFile_Click" Width="34" Height="34" Padding="0" Background="#092845" BorderBrush="#1A567F"><FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="#83C8FF"/></Button><Button Tag="{x:Bind}" Click="MoveToTrash_Click" Width="34" Height="34" Padding="0" Background="#2A111B" BorderBrush="#723044"><FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="#FF5F7A"/></Button></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
            <Border Grid.Row="3" Background="#08243E" BorderBrush="#143B5B" BorderThickness="1" CornerRadius="6" Padding="18,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Готово" FontSize="10" Foreground="#6FA0C2"/><Grid Margin="0,10,0,0"><ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Value="0"/><TextBlock x:Name="ProgressText" Text="0%" FontSize="10" HorizontalAlignment="Right" Margin="0,-18,0,0"/></Grid></StackPanel><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Всего файлов" FontSize="9" Foreground="#719AB8"/><TextBlock x:Name="FilesStat" Text="0" FontSize="14" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Групп дублей" FontSize="9" Foreground="#719AB8"/><TextBlock x:Name="GroupsStat" Text="0" FontSize="14" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Общий размер" FontSize="9" Foreground="#719AB8"/><TextBlock x:Name="BytesStat" Text="0 Б" FontSize="14" FontWeight="SemiBold"/></StackPanel></Grid></Grid></Border>
        </Grid>
    </Grid>
</Window>
