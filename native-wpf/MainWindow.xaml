<Window x:Class="SoundCloudReleaseTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Release Radar v7.1"
        Width="1440" Height="900"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0E1116"
        Foreground="#F3F5F7"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0E1116"/>
        <SolidColorBrush x:Key="Sidebar" Color="#131821"/>
        <SolidColorBrush x:Key="Card" Color="#171D27"/>
        <SolidColorBrush x:Key="CardAlt" Color="#1D2430"/>
        <SolidColorBrush x:Key="Border" Color="#2A3442"/>
        <SolidColorBrush x:Key="Text" Color="#F3F5F7"/>
        <SolidColorBrush x:Key="Muted" Color="#9BA8B8"/>
        <SolidColorBrush x:Key="Accent" Color="#FF5500"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FF6B21"/>
        <SolidColorBrush x:Key="Success" Color="#35C98B"/>
        <SolidColorBrush x:Key="Danger" Color="#EA6363"/>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="0,2">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#202938"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource CardAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#273140"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="{StaticResource CardAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25303E"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33261F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#27313E"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowBackground" Value="{StaticResource Card}"/>
            <Setter Property="AlternatingRowBackground" Value="#151B24"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1C2430"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2B2523"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="26,10,26,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Release Radar" FontSize="29" FontWeight="SemiBold"/>
                <TextBlock Text="SoundCloud release tracker  •  v7.1"
                           Foreground="{StaticResource Muted}"
                           FontSize="12"
                           Margin="1,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="#14261F"
                    BorderBrush="#215B45"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12,6"
                    VerticalAlignment="Center">
                <TextBlock x:Name="ConnectionBadge"
                           Text="●  SoundCloud не подключён"
                           Foreground="{StaticResource Danger}"
                           FontSize="13"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="18,0,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="206"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Sidebar}"
                    CornerRadius="12"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Button x:Name="NavTracks" Content="Новые треки"
                                Style="{StaticResource NavButton}"
                                Click="NavTracks_Click"/>
                        <Button x:Name="NavArtists" Content="Артисты и BPM"
                                Style="{StaticResource NavButton}"
                                Click="NavArtists_Click"/>
                        <Button x:Name="NavSettings" Content="Настройки"
                                Style="{StaticResource NavButton}"
                                Click="NavSettings_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2"
                               Text="Мониторинг новых релизов&#10;по жанрам и BPM"
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               Margin="8,0,8,8"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <!-- TRACKS -->
                <Grid x:Name="TracksPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Новые треки" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="TrackCountText" Style="{StaticResource MutedText}" Margin="1,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="156"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="134"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Проверить сейчас" Style="{StaticResource PrimaryButton}"
                                Click="CheckNow_Click"/>
                        <Button x:Name="MonitorButton" Grid.Column="2" Content="Мониторинг"
                                Style="{StaticResource SecondaryButton}" Click="Monitor_Click"/>
                        <Button Grid.Column="4" Content="Preview"
                                Style="{StaticResource SecondaryButton}" Click="Preview_Click"/>
                        <Button Grid.Column="6" Content="Stop"
                                Style="{StaticResource SecondaryButton}" Click="Stop_Click"/>
                        <Button Grid.Column="8" Content="Скачать"
                                Style="{StaticResource SecondaryButton}" Click="Download_Click"/>
                        <Button Grid.Column="10" Content="Открыть в SoundCloud"
                                Style="{StaticResource SecondaryButton}" Click="OpenSoundCloud_Click"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="142"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="390"/>
                        </Grid.ColumnDefinitions>

                        <ToggleButton x:Name="OnlyFavoritesCheck"
                                      Content="★  Любимые"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource FilterToggle}"
                                      Checked="FilterChanged" Unchecked="FilterChanged"/>

                        <ToggleButton x:Name="OnlyDownloadCheck"
                                      Grid.Column="1"
                                      Content="↓  Downloadable"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource FilterToggle}"
                                      Checked="FilterChanged" Unchecked="FilterChanged"/>

                        <Grid Grid.Column="3" Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="SearchBox"
                                         TextChanged="SearchBox_TextChanged"
                                         Padding="12,8"/>
                                <TextBlock x:Name="SearchHint"
                                           Text="Поиск по артисту, названию или жанру…"
                                           Foreground="#718095"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                            <Button x:Name="ClearSearchButton"
                                    Grid.Column="1"
                                    Content="×"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    IsEnabled="False"
                                    ToolTip="Очистить поиск"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ClearSearch_Click"/>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="3"
                            Background="{StaticResource Card}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            ClipToBounds="True">
                        <DataGrid x:Name="TracksGrid"
                                  AlternationCount="2"
                                  IsReadOnly="True"
                                  MouseDoubleClick="TracksGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ДАТА" Binding="{Binding DisplayCreatedAt}" Width="160"/>
                                <DataGridTextColumn Header="АРТИСТ" Binding="{Binding Artist}" Width="220"/>
                                <DataGridTextColumn Header="НАЗВАНИЕ" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="ЖАНР" Binding="{Binding Genre}" Width="150"/>
                                <DataGridTextColumn Header="BPM" Binding="{Binding Bpm}" Width="76"/>
                                <DataGridTemplateColumn Header="DOWNLOAD" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="15">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="—"/>
                                                        <Setter Property="Foreground" Value="#637083"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Downloadable}" Value="True">
                                                                <Setter Property="Text" Value="✓"/>
                                                                <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- ARTISTS -->
                <Grid x:Name="ArtistsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Артисты и BPM" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Любимые артисты, blacklist и BPM-правила"
                                   Style="{StaticResource MutedText}" Margin="1,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource Card}" CornerRadius="10"
                                BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Любимые артисты" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Один артист на строку" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="FavoritesBox" Grid.Row="2" Margin="0,10,0,0"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="10"
                                BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Blacklist" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Не показывать этих артистов" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="BlacklistBox" Grid.Row="2" Margin="0,10,0,0"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Background="{StaticResource Card}" CornerRadius="10"
                                BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="BPM-правила" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Например: House=122-132" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="BpmRulesBox" Grid.Row="2" Margin="0,10,0,0"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Button Content="Сохранить изменения"
                                Width="190"
                                HorizontalAlignment="Right"
                                Style="{StaticResource PrimaryButton}"
                                Click="SaveSettings_Click"/>
                    </Grid>
                </Grid>

                <!-- SETTINGS -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="176"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Подключение SoundCloud и параметры мониторинга"
                                   Style="{StaticResource MutedText}" Margin="1,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{StaticResource Card}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="138"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="128"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Подключение SoundCloud" FontSize="17" FontWeight="SemiBold"
                                       Grid.ColumnSpan="4"/>
                            <TextBlock x:Name="SettingsConnectionText" Grid.Row="1"
                                       Foreground="{StaticResource Muted}" Grid.ColumnSpan="4"/>

                            <TextBox x:Name="ClientIdBox" Grid.Row="2" IsReadOnly="True"
                                     Margin="0,4,12,4"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="Подключить"
                                    Style="{StaticResource PrimaryButton}" Click="Connect_Click"/>
                            <Button Grid.Row="2" Grid.Column="3" Content="Проверить API"
                                    Style="{StaticResource SecondaryButton}" Click="TestApi_Click"/>

                            <TextBlock Grid.Row="3" Grid.ColumnSpan="3"
                                       Text="Пароль вводится только на официальном сайте. Client Secret хранится в Windows Credential Manager."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Row="3" Grid.Column="3" Content="Отключить"
                                    Style="{StaticResource SecondaryButton}" Click="Disconnect_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{StaticResource Card}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Мониторинг" FontSize="17" FontWeight="SemiBold" Grid.ColumnSpan="3"/>

                            <TextBlock Grid.Row="1" Text="Жанры" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBox x:Name="GenresBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5,0,5"/>

                            <TextBlock Grid.Row="2" Text="Проверять каждые" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBox x:Name="PollBox" Grid.Row="2" Grid.Column="1" Margin="0,5,12,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="минут" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Text="Искать за последние" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBox x:Name="LookbackBox" Grid.Row="3" Grid.Column="1" Margin="0,5,12,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="часов" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4" Text="Папка загрузки" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBox x:Name="DownloadDirBox" Grid.Row="4" Grid.Column="1" Margin="0,5,12,5"/>
                            <Button Grid.Row="4" Grid.Column="2" Content="Выбрать…"
                                    Style="{StaticResource SecondaryButton}" Click="Browse_Click"/>

                            <CheckBox x:Name="AutoDownloadCheck" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                      Content="Автоматически скачивать только официально downloadable треки"/>

                            <Button Grid.Row="6" Grid.Column="2" Content="Сохранить"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#11161E" Padding="22,0">
            <TextBlock x:Name="StatusText"
                       Text="Готово"
                       Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center"
                       FontSize="12"/>
        </Border>
    </Grid>
</Window>
